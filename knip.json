{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "entry": [
    "src/index.ts",
    "src/server-http.ts",
    "src/cli/*.ts",
    "src/mcp-apps/*.tsx",
    "scripts/*.ts",
    "site/build-site.ts",
    "site/page-script.ts",
    "site/site-app.tsx"
  ],
  "project": ["src/**/*.{ts,tsx}", "scripts/**/*.ts", "site/**/*.{ts,tsx}", "tests/**/*.ts"],
  "ignoreExportsUsedInFile": { "interface": true, "type": true },
  "ignore": ["src/ebay-openapi-types/**"]
}
