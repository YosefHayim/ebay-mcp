# eBay application keys from https://developer.ebay.com/my/keys
EBAY_CLIENT_ID=your-client-id
EBAY_CLIENT_SECRET=your-client-secret

# sandbox or production. Defaults to sandbox.
EBAY_ENVIRONMENT=sandbox

# User refresh token. Required for inventory calls and user rate limits.
EBAY_USER_REFRESH_TOKEN=your-refresh-token

# Optional. Sent as X-EBAY-C-MARKETPLACE-ID. Defaults to EBAY_US.
EBAY_MARKETPLACE_ID=EBAY_US

# Optional. Sent as Content-Language. Defaults to en-US.
EBAY_CONTENT_LANGUAGE=en-US
