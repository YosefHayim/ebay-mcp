{
	"extends": "./tsconfig.json",
	"compilerOptions": {
		"noEmit": true,
		"rootDir": ".",
		"declaration": false,
		"incremental": true,
		"tsBuildInfoFile": "node_modules/.cache/tsc/scripts.tsbuildinfo"
	},
	"include": ["scripts/**/*.ts", "src/**/*"],
	"exclude": [
		"node_modules",
		"build",
		"tests",
		"src/**/*.test.ts",
		"scripts/**/*.test.ts",
		"src/ebay-apis/analytics/testHarness.ts",
		"src/mcp-apps",
		"vitest.config.cts"
	]
}
