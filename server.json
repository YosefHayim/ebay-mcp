{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.YosefHayim/ebay-mcp",
  "title": "eBay Seller Tools",
  "description": "Local MCP server for the eBay REST APIs, using your own keys.",
  "repository": {
    "url": "https://github.com/YosefHayim/ebay-mcp",
    "source": "github"
  },
  "version": "3.0.0",
  "packages": [
    {
      "registryType": "npm",
      "identifier": "ebay-mcp",
      "version": "3.0.0",
      "transport": {
        "type": "stdio"
      },
      "environmentVariables": [
        {
          "name": "EBAY_CLIENT_ID",
          "description": "eBay Developer app client ID",
          "isRequired": true,
          "isSecret": true,
          "format": "string"
        },
        {
          "name": "EBAY_CLIENT_SECRET",
          "description": "eBay Developer app client secret",
          "isRequired": true,
          "isSecret": true,
          "format": "string"
        },
        {
          "name": "EBAY_ENVIRONMENT",
          "description": "sandbox or production",
          "isRequired": false,
          "default": "sandbox",
          "choices": ["sandbox", "production"],
          "format": "string"
        },
        {
          "name": "EBAY_USER_REFRESH_TOKEN",
          "description": "User refresh token for inventory and user rate limits",
          "isRequired": false,
          "isSecret": true,
          "format": "string"
        },
        {
          "name": "EBAY_MARKETPLACE_ID",
          "description": "X-EBAY-C-MARKETPLACE-ID, for example EBAY_US",
          "isRequired": false,
          "default": "EBAY_US",
          "format": "string"
        },
        {
          "name": "EBAY_CONTENT_LANGUAGE",
          "description": "Content-Language header, for example en-US",
          "isRequired": false,
          "default": "en-US",
          "format": "string"
        }
      ]
    }
  ]
}
