{
  "name": "ebay-mcp",
  "mcpName": "io.github.YosefHayim/ebay-mcp",
  "version": "3.0.0",
  "description": "A local MCP server that calls the eBay Sell and Developer APIs with your own keys.",
  "type": "module",
  "main": "build/index.js",
  "types": "build/index.d.ts",
  "bin": {
    "ebay-mcp": "build/index.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "node build/index.js",
    "dev": "tsx src/index.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "sync": "tsx scripts/sync-specs.ts",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "check": "turbo run lint typecheck test build --output-logs=errors-only",
    "prepare": "husky"
  },
  "keywords": [
    "mcp",
    "ebay",
    "model-context-protocol"
  ],
  "author": "Yosef Hayim Sabag",
  "license": "MIT",
  "files": [
    "build/**/*.js",
    "build/**/*.d.ts",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/YosefHayim/ebay-mcp.git"
  },
  "homepage": "https://github.com/YosefHayim/ebay-mcp#readme",
  "bugs": {
    "url": "https://github.com/YosefHayim/ebay-mcp/issues"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.4.0",
    "zod": "^4.2.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.1",
    "@types/node": "^25.9.3",
    "husky": "^9.1.7",
    "openapi-typescript": "^7.13.0",
    "tsx": "^4.22.4",
    "turbo": "2.11.8",
    "typescript": "^5.9.3",
    "vitest": "^4.1.12"
  },
  "packageManager": "pnpm@10.14.0",
  "engines": {
    "node": ">=24"
  },
  "pnpm": {
    "overrides": {
      "esbuild": ">=0.28.1",
      "yaml": ">=2.8.3",
      "js-yaml": "^4.3.2",
      "brace-expansion@^2.0.0": "^2.1.7",
      "fast-uri": "^3.1.8",
      "ip-address": "^10.7.1",
      "nanoid@^3.0.0": "^3.3.18",
      "postcss": "^8.5.23",
      "qs": "^6.16.0",
      "source-map-js": "^1.2.2"
    }
  }
}
