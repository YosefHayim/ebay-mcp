{
  "$schema": "https://biomejs.dev/schemas/2.5.1/schema.json",
  "vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true, "defaultBranch": "main" },
  "files": {
    "ignoreUnknown": true,
    "includes": ["**", "!src/ebay-openapi-types"]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "trailingCommas": "all",
      "semicolons": "always"
    }
  },
  "assist": {
    "enabled": true,
    "actions": {
      "source": {
        "useSortedKeys": "off",
        "useSortedPackageJson": "off",
        "useSortedAttributes": "off",
        "organizeImports": "off"
      }
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "all",
      "nursery": {
        "useSortedClasses": "warn"
      },
      "style": {
        "noDefaultExport": "warn",
        "noJsxLiterals": "off",
        "useComponentExportOnlyModules": "off",
        "noTernary": "off",
        "noNestedTernary": "warn",
        "useNamingConvention": "off",
        "useFilenamingConvention": {
          "level": "warn",
          "options": { "filenameCases": ["kebab-case"] }
        },
        "useImportType": "warn",
        "noMagicNumbers": "off",
        "noCommonJs": "off",
        "useExportsLast": "warn",
        "noIncrementDecrement": "off",
        "noProcessEnv": "warn",
        "noExcessiveLinesPerFile": {
          "level": "warn",
          "options": { "maxLines": 300 }
        }
      },
      "correctness": {
        "noNodejsModules": "off",
        "noUndeclaredDependencies": "warn",
        "noUndeclaredVariables": "warn",
        "noUnresolvedImports": "off",
        "useImportExtensions": "off",
        "useQwikValidLexicalScope": "off",
        "useHookAtTopLevel": "off"
      },
      "performance": {
        "useSolidForComponent": "off",
        "noJsxPropsBind": "warn",
        "noAwaitInLoops": "warn",
        "useTopLevelRegex": "warn"
      },
      "suspicious": {
        "noDoubleEquals": "off",
        "noEqualsToNull": "off",
        "noVar": "off",
        "noConsole": "warn",
        "noUnknownAttribute": "off",
        "noUnnecessaryConditions": "warn",
        "noControlCharactersInRegex": "off",
        "noNonNullAssertedOptionalChain": "warn",
        "noAssignInExpressions": "off",
        "noReturnAssign": "off",
        "noArrayIndexKey": "warn",
        "useIterableCallbackReturn": "warn"
      },
      "security": {
        "noSecrets": "off"
      },
      "complexity": {
        "noExcessiveCognitiveComplexity": "warn",
        "noExcessiveLinesPerFunction": {
          "level": "warn",
          "options": { "maxLines": 60 }
        },
        "noVoid": "off"
      }
    },
    "domains": {
      "test": "all",
      "project": "all"
    }
  },
  "overrides": [
    {
      "includes": ["src/index.ts", "src/ebay-client.ts", "src/environment.ts", "scripts/**"],
      "linter": {
        "rules": {
          "style": { "noProcessEnv": "off" },
          "suspicious": { "noConsole": "off" }
        }
      }
    },
    {
      "includes": ["src/**/*.test.ts"],
      "linter": {
        "rules": {
          "complexity": { "noExcessiveLinesPerFunction": "off" }
        }
      }
    },
    {
      "includes": ["vitest.config.ts"],
      "linter": {
        "rules": {
          "style": { "noDefaultExport": "off" }
        }
      }
    }
  ]
}
