{
	"extends": "./tsconfig.base.json",
	"compilerOptions": {
		"module": "Node16",
		"moduleResolution": "Node16",
		"outDir": "./build",
		"rootDir": "./src",
		"esModuleInterop": true,
		"declaration": true,
		"declarationMap": false,
		"sourceMap": false,
		"paths": { "@/*": ["./src/*"] },
		"baseUrl": "."
	},
	"include": ["src/**/*"],
	"exclude": [
		"node_modules",
		"build",
		"tests",
		"src/**/*.test.ts",
		"src/ebay-apis/analytics/testHarness.ts",
		"src/mcp-apps",
		"vitest.config.cts"
	]
}
